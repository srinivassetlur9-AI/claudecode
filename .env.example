# Copy to .env. Never commit the real file.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:8081

# First Super Admin (created on startup if it does not exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisNow123

# Local trials only: one active user per role with password Demo@12345678. Keep false everywhere else.
SEED_DEMO_USERS=false
